# ==========================================
# ENTREPRENEUR SCHEME COPILOT - ENVIRONMENT
# ==========================================

# Application Environment (development / production)
ENVIRONMENT=development

# Security
# Generate a strong key using: openssl rand -hex 32
SECRET_KEY=change-me-in-production

# Authentication
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# For SQLite (local): sqlite:///./sql_app.db
# For PostgreSQL (production): postgresql://user:password@localhost:5432/schemedb
DATABASE_URL=sqlite:///./sql_app.db

# CORS Configuration
# Use comma-separated list of origins for production
CORS_ORIGINS=*

# API Keys
AI_API_KEY=your-gemini-api-key-here
